<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="snake_module" params="index parent">
    <link name="module_${index}_yaw_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.0001" ixy="0" ixz="0"
          iyy="0.0001" iyz="0"
          izz="0.0001"/>
      </inertial>
    </link>

    <joint name="joint_${index}_yaw" type="revolute">
      <parent link="${parent}"/>
      <child link="module_${index}_yaw_link"/>
      <origin xyz="0.16 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.0472" upper="1.0472" effort="20.0" velocity="2.0"/>
    </joint>

    <link name="module_${index}_link">
      <visual>
        <origin xyz="0.08 0 0"/>
        <geometry>
          <box size="0.16 0.08 0.06"/>
        </geometry>
        <material name="snake_green">
          <color rgba="0.15 0.65 0.55 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0.08 0 0"/>
        <geometry>
          <box size="0.16 0.08 0.06"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0.08 0 0"/>
        <mass value="0.5"/>
        <inertia
          ixx="0.00042" ixy="0" ixz="0"
          iyy="0.00127" iyz="0"
          izz="0.00133"/>
      </inertial>
    </link>

    <joint name="joint_${index}_pitch" type="revolute">
      <parent link="module_${index}_yaw_link"/>
      <child link="module_${index}_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.0472" upper="1.0472" effort="20.0" velocity="2.0"/>
    </joint>
  </xacro:macro>
</robot>