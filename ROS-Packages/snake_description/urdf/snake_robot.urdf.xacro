<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="snake_robot">

  <xacro:include filename="$(find snake_description)/urdf/snake_links.xacro"/>
  <xacro:include filename="$(find snake_description)/urdf/snake_ros2_control.xacro"/>
<link name="base_link">
    <visual>
      <origin xyz="0.08 0 0"/>
      <geometry>
        <box size="0.16 0.09 0.07"/>
      </geometry>
      <material name="snake_head">
        <color rgba="0.1 0.35 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <xacro:snake_module index="1" parent="base_link"/>
  <xacro:snake_module index="2" parent="module_1_link"/>
  <xacro:snake_module index="3" parent="module_2_link"/>
  <xacro:snake_module index="4" parent="module_3_link"/>

  <!-- Instantiate the ros2_control hardware and all eight joint interfaces. -->
  <xacro:snake_ros2_control/>

</robot>
