<?xml version="1.0"?>
<package format="3">
  <name>snake_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and controller configuration for the snake robot.</description>

  <maintainer email="amoy@example.com">amoy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>snake_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>snake_gait_controller</exec_depend>
  <depend>geometry_msgs</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
