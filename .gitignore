# This repository is an integration workspace. The repositories imported by
# repos/joho_snake_robot.repos keep their own history and .gitignore files.
/src/*/
/firmware/*/
/simulation/

# ROS 2 / colcon outputs produced from this workspace.
/build/
/install/
/log/
/.colcon/
/.ros/
/colcon_core/
/colcon-related-*/

# Other root-level CMake outputs.
/cmake-build-*/
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/CTestTestfile.cmake
/compile_commands.json

# Python bytecode, environments, packaging, and test artifacts.
__pycache__/
*.py[cod]
*$py.class
/.venv/
/venv/
/env/
/ENV/
/.eggs/
*.egg-info/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.tox/
/.nox/
/.coverage
/.coverage.*
/coverage/
/coverage.xml
/htmlcov/
/dist/
/pip-wheel-metadata/

# Local environment files. Keep shareable templates under version control.
.env
.env.*
!.env.example
!.env.*.example

# JavaScript package-manager caches and diagnostics.
/node_modules/
/.cache/
/.pnpm-store/
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-debug.log*

# Runtime diagnostics generated at the workspace root.
/Log/
/*.pid
/*.seed

# Keep portable VS Code settings; ignore only generated IntelliSense data.
/.vscode/browse.vc.db*
/.vscode/ipch/
/.vscode/*.log
/.idea/
/.vscode-ide/
*.sublime-workspace
*.sublime-project

# Editor backups and operating-system metadata.
*~
*.swp
*.swo
*.tmp
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db
Desktop.ini
*.db
browse.vc.2.*
*.txt

