{
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/install",
        "/opt/ros/jazzy/lib/python3.12/site-packages"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/install",
        "/opt/ros/jazzy/lib/python3.12/site-packages"
    ],
    "git.autoRepositoryDetection": "all",
    "editor.formatOnSave": true,
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.clang_format_fallbackStyle": "Google",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.autoAddFileAssociations": true,
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    "C_Cpp.default.cStandard": "gnu11",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
    "C_Cpp.default.compileCommands": "${workspaceFolder:joho integration}/build/compile_commands.json",
    "C_Cpp.default.includePath": [
        "${workspaceFolder:joho integration}/src/**",
        "${workspaceFolder:joho integration}/install/**",
        "/opt/ros/jazzy/include",
        "/usr/include/pcl-1.14",
        "/usr/include/eigen3"
    ],
    "C_Cpp.default.browse.path": [
        "${workspaceFolder:joho integration}/src",
        "${workspaceFolder:joho integration}/install",
        "/opt/ros/jazzy/include"
    ],
    "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": false,
    "files.watcherExclude": {
        "**/build/**/CMakeFiles/**": true,
        "**/install/**": true,
        "**/log/**": true,
        "**/.git/objects/**": true
    }
}
