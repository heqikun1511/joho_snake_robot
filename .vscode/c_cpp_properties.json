{
  "version": 4,
  "configurations": [
    {
      "name": "ROS 2 Jazzy (Host)",
      "compilerPath": "/usr/bin/g++",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "gnu11",
      "cppStandard": "c++17",
      "compileCommands": "${workspaceFolder:joho integration}/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder:joho integration}/src/**",
        "${workspaceFolder:joho integration}/install/**",
        "/opt/ros/jazzy/include",
        "/usr/include/pcl-1.14",
        "/usr/include/eigen3"
      ],
      "browse": {
        "databaseFilename": "${workspaceFolder:joho integration}/.vscode/browse.vc.db",
        "path": [
          "${workspaceFolder:joho integration}/src",
          "${workspaceFolder:joho integration}/install",
          "/opt/ros/jazzy/include"
        ],
        "limitSymbolsToIncludedHeaders": false
      }
    }
  ]
}
